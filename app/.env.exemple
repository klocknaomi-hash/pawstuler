# Copie ce fichier en « .env » (même dossier) et remplis les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub.
# Tant que ces deux lignes sont vides, l'app reste en mode démo (compte local).

# Supabase › Project Settings › API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat › Project settings › API keys › clé publique iOS (commence par « appl_ »)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
