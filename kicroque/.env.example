# Copiez ce fichier en .env (local) ou saisissez ces variables dans
# Vercel › Project › Settings › Environment Variables. Ne JAMAIS les committer.

# Adresse publique du site (sert au retour après paiement)
SITE_URL=https://www.kicroque.fr

# Stripe (Dashboard › Développeurs › Clés API / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (e-mails) — domaine kicroque.fr à vérifier chez Resend
RESEND_API_KEY=re_...
OWNER_EMAIL=contact@kicroque.fr
FROM_EMAIL=KiCroque <commandes@kicroque.fr>

# Upstash Redis (jauge des 8 commandes / jour, 1re commande, commandes)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
