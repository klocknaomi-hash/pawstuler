{
  "name": "amitie",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace mobile",
    "test": "npm run test --workspace @amitie/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:verifier": "bash supabase/tests/verifier_base.sh",
    "verifier": "npm run typecheck && npm run lint && npm run test && npm run db:verifier"
  }
}
